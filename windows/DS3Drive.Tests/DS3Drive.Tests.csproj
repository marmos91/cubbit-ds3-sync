<Project Sdk="Microsoft.NET.Sdk">

  <!--
    DS3Drive.Tests — xUnit tests for DS3Drive.Sync + DS3Drive.Core.
    See 17-CONTEXT.md D-33 and 17-PATTERNS.md §1.4.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DS3Drive.Core\DS3Drive.Core.csproj" />
    <ProjectReference Include="..\DS3Drive.Sync\DS3Drive.Sync.csproj" />
    <!-- ViewModels reference exercises the LoginViewModel 2FA routing + tutorial registry
         write WITHOUT the WinUI App project (which crashes the headless test host on the
         Windows App Runtime bootstrap) — Plan 08 Task 2/3 / deviation. -->
    <ProjectReference Include="..\DS3Drive.ViewModels\DS3Drive.ViewModels.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="NSubstitute" />
  </ItemGroup>

  <!--
    xunit.runner.json must sit next to the test assembly for xUnit to honour the
    parallelizeAssembly=false / maxParallelThreads=1 settings (cfapi-style tests
    cannot interleave — VALIDATION Wave 0). PreserveNewest keeps it in bin/.
  -->
  <ItemGroup>
    <None Update="xunit.runner.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
