<?xml version="1.0" encoding="utf-8"?>
<!--
    TrayFlyoutView — the FrameworkElement-rooted content of the Acrylic 360x540 tray flyout
    (UI-SPEC §Component Inventory TrayHost row + §Interaction Contracts Tray). Layout (top→bottom):
      - Header: "DS3 Drive" + aggregate StatusPill
      - ListView<TrayDriveRowViewModel> bound to TrayViewModel.DriveRows (empty state if none)
      - Divider + "Recent activity" + ListView<RecentFileEntry> (global top 5)
      - Divider + footer button row: Add drive (hidden at the 3-drive cap) / Settings / Help / Quit
    Outer padding Space.md (16px, UI-SPEC Revision 3). Port of TrayMenuView.swift.

    NOTE (Rule-3 deviation, see 17-11-SUMMARY): WinUI 3 forbids {x:Bind} on a <Window> root
    (Window is not a FrameworkElement, so the generated Bindings code fails to compile —
    CS1503). The flyout content therefore lives in this UserControl with a ViewModel DP as the
    x:Bind source (same pattern as TrayDriveRow / StatusPill), and TrayFlyoutWindow hosts it as
    its Content. SystemBackdrop=DesktopAcrylicBackdrop + chrome removal stay on the Window.
-->
<UserControl
    x:Class="DS3Drive.App.Tray.TrayFlyoutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DS3Drive.App.Controls"
    xmlns:vm="using:DS3Drive.ViewModels.ViewModels"
    xmlns:svc="using:DS3Drive.ViewModels.Services"
    xmlns:conv="using:DS3Drive.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Converters used by {x:Bind} must live in the control-level resources: the generated
         binding code resolves them against this UserControl's Resources, not a child element's. -->
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Padding="16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header. -->
        <Grid Grid.Row="0">
            <TextBlock Style="{StaticResource Type.H2}" Text="DS3 Drive" VerticalAlignment="Center" />
            <controls:StatusPill x:Name="AggregatePill" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <!-- Drives list. -->
        <ListView Grid.Row="1"
                  x:Name="DrivesList"
                  SelectionMode="None"
                  ItemsSource="{x:Bind ViewModel.DriveRows, Mode=OneWay}"
                  Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:TrayDriveRowViewModel">
                    <controls:TrayDriveRow ViewModel="{x:Bind}" HorizontalAlignment="Stretch" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Empty state (UI-SPEC §Empty states — Drives list no drives). -->
        <StackPanel Grid.Row="1" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource Type.Body}" HorizontalAlignment="Center" Text="No drives yet" />
            <TextBlock Style="{StaticResource Type.Caption}" HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="300"
                       Text="Add a drive to start syncing files between this PC and Cubbit DS3." />
        </StackPanel>

        <!-- Recent activity. -->
        <Border Grid.Row="2" Height="1" Background="{ThemeResource DividerBrush}" />
        <StackPanel Grid.Row="3" Spacing="8">
            <TextBlock Style="{StaticResource Type.Caption}" Text="Recent activity" />
            <ListView SelectionMode="None"
                      ItemsSource="{x:Bind ViewModel.RecentFiles, Mode=OneWay}"
                      MaxHeight="120">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="svc:RecentFileEntry">
                        <StackPanel Orientation="Horizontal" Spacing="8" Padding="0,4">
                            <TextBlock Style="{StaticResource Type.Caption}" Text="{x:Bind DisplayName}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <!-- Footer actions. -->
        <Grid Grid.Row="4" ColumnSpacing="8">
            <Border Height="1" VerticalAlignment="Top" Background="{ThemeResource DividerBrush}" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <Button x:Name="AddDriveButton" Content="Add drive"
                        Command="{x:Bind ViewModel.AddDriveCommand}"
                        Visibility="{x:Bind ViewModel.CanAddDrive, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        AutomationProperties.Name="Add drive" />
                <Button Content="Settings"
                        Command="{x:Bind ViewModel.OpenSettingsCommand}"
                        AutomationProperties.Name="Settings" />
                <Button x:Name="HelpButton" Content="Help"
                        Click="OnHelpClick"
                        AutomationProperties.Name="Help" />
                <Button Content="Quit"
                        Command="{x:Bind ViewModel.QuitCommand}"
                        AutomationProperties.Name="Quit" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
