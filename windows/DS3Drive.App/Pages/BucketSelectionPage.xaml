<?xml version="1.0" encoding="utf-8"?>
<!--
    BucketSelectionPage — wizard step 2 (Bucket). Per 17-UI-SPEC.md §"Component Inventory":
    ListView of DS3Bucket (Type.Body name, Type.Caption creation date), "Loading buckets…"
    ProgressRing, InfoBar on error, and the "No buckets in this project" empty state.
    Selecting a row calls DriveSetupViewModel.SelectBucket (advances to Prefix).
-->
<Page
    x:Class="DS3Drive.App.Pages.BucketSelectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DS3Drive.ViewModels.ViewModels"
    xmlns:records="using:DS3Drive.Core.Records"
    xmlns:conv="using:DS3Drive.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid Padding="24">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16"
                    Visibility="{x:Bind ViewModel.IsLoadingBuckets, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <ProgressRing Width="24" Height="24" IsActive="True" HorizontalAlignment="Center" />
            <TextBlock Style="{StaticResource Type.BodySecondary}" HorizontalAlignment="Center" Text="Loading buckets…" />
        </StackPanel>

        <StackPanel Spacing="16"
                    Visibility="{x:Bind ViewModel.IsLoadingBuckets, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">

            <InfoBar IsOpen="True" Severity="Error"
                     Title="Couldn't load buckets."
                     Message="Check your connection and try again."
                     Visibility="{x:Bind ViewModel.CreationError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

            <ListView x:Name="BucketsList"
                      ItemsSource="{x:Bind ViewModel.Buckets, Mode=OneWay}"
                      SelectionMode="Single"
                      SelectionChanged="BucketsList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="records:DS3Bucket">
                        <StackPanel Spacing="4" Padding="0,8">
                            <TextBlock Style="{StaticResource Type.Body}" Text="{x:Bind Name}" />
                            <TextBlock Style="{StaticResource Type.Caption}" Text="{x:Bind CreationDate}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Spacing="8" HorizontalAlignment="Center" Padding="0,32"
                        Visibility="{x:Bind HasNoBuckets(ViewModel.Buckets.Count, ViewModel.IsLoadingBuckets), Mode=OneWay}">
                <TextBlock Style="{StaticResource Type.H2}" HorizontalAlignment="Center" Text="No buckets in this project" />
                <TextBlock Style="{StaticResource Type.BodySecondary}" HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="420"
                           Text="Create a bucket in the Cubbit console, then return here to continue." />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
