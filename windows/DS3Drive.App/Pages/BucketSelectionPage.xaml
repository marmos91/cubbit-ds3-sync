<?xml version="1.0" encoding="utf-8"?>
<!--
    BucketSelectionPage — wizard step 2 (Bucket). Per 17-UI-SPEC.md §"Component Inventory":
    ListView of DS3Bucket (Type.Body name, Type.Caption creation date), "Loading buckets…"
    ProgressRing, InfoBar on error, and the "No buckets in this project" empty state.
    Selecting a row calls DriveSetupViewModel.SelectBucket (advances to Prefix).
-->
<Page
    x:Class="DS3Drive.App.Pages.BucketSelectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DS3Drive.ViewModels.ViewModels"
    xmlns:records="using:DS3Drive.Core.Records"
    xmlns:conv="using:DS3Drive.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:NotNullToBoolConverter x:Key="NotNullToBool" />
    </Page.Resources>

    <Grid Padding="24">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16"
                    Visibility="{x:Bind ViewModel.IsLoadingBuckets, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <ProgressRing Width="24" Height="24" IsActive="True" HorizontalAlignment="Center" />
            <TextBlock Style="{StaticResource Type.BodySecondary}" HorizontalAlignment="Center" Text="Loading buckets…" />
        </StackPanel>

        <StackPanel Spacing="16"
                    Visibility="{x:Bind ViewModel.IsLoadingBuckets, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">

            <!-- IAM-user picker: lists the project's IAM users with a "(root)" tag, defaults to the
                 root user, and re-lists buckets when the selection changes (SelectedIamUser →
                 OnSelectedIamUserChanged). Shown when the project exposes at least one IAM user. -->
            <ComboBox x:Name="UserPicker"
                      Header="IAM user"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{x:Bind ViewModel.AvailableUsers, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedIamUser, Mode=TwoWay}"
                      DisplayMemberPath="DisplayLabel"
                      Visibility="{x:Bind UserPickerVisibility(ViewModel.AvailableUsers.Count), Mode=OneWay}"
                      AutomationProperties.Name="IAM user" />

            <!-- On a bucket-load failure the wizard stays on this step and surfaces the mapped error
                 copy inline (DriveSetupViewModel.MapErrorCopy) with a Retry that re-invokes
                 LoadBucketsCommand. -->
            <InfoBar Severity="Error"
                     Title="Couldn't load buckets."
                     IsOpen="{x:Bind ViewModel.CreationError, Mode=OneWay, Converter={StaticResource NotNullToBool}}"
                     Message="{x:Bind ViewModel.CreationError, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Content="Retry" Command="{x:Bind ViewModel.LoadBucketsCommand, Mode=OneWay}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <ListView x:Name="BucketsList"
                      ItemsSource="{x:Bind ViewModel.Buckets, Mode=OneWay}"
                      SelectionMode="Single"
                      SelectionChanged="BucketsList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="records:DS3Bucket">
                        <StackPanel Spacing="4" Padding="0,8">
                            <TextBlock Style="{StaticResource Type.Body}" Text="{x:Bind Name}" />
                            <TextBlock Style="{StaticResource Type.Caption}" Text="{x:Bind CreationDate}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Spacing="8" HorizontalAlignment="Center" Padding="0,32"
                        Visibility="{x:Bind HasNoBuckets(ViewModel.Buckets.Count, ViewModel.IsLoadingBuckets, ViewModel.CreationError), Mode=OneWay}">
                <TextBlock Style="{StaticResource Type.H2}" HorizontalAlignment="Center" Text="No buckets in this project" />
                <TextBlock Style="{StaticResource Type.BodySecondary}" HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="420"
                           Text="Create a bucket in the Cubbit console, then return here to continue." />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
