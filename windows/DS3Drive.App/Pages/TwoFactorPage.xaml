<?xml version="1.0" encoding="utf-8"?>
<!--
    TwoFactorPage.xaml — 2FA challenge. Port of
    apple/DS3Drive/Views/Login/Views/MFAView.swift (PATTERNS §2.4 sibling).
    Copy verbatim per 17-UI-SPEC.md §Copywriting Contract: subhead "Two-factor
    authentication", primary CTA "Verify", error InfoBar "That code didn't work.…".
    6-digit numeric field (InputScope=NumericPin, MaxLength=6).
-->
<Page
    x:Class="DS3Drive.App.Pages.TwoFactorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DS3Drive.ViewModels.ViewModels"
    xmlns:conv="using:DS3Drive.App.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:NotNullToBoolConverter x:Key="NotNullToBool" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid Padding="32">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16"
                    MaxWidth="360">

            <TextBlock Style="{StaticResource Type.H2}"
                       HorizontalAlignment="Center"
                       Text="Two-factor authentication" />

            <TextBlock Style="{StaticResource Type.BodySecondary}"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       Text="Enter the 6-digit code from your authenticator app." />

            <TextBox x:Name="CodeBox"
                     InputScope="NumericPin"
                     MaxLength="6"
                     HorizontalAlignment="Stretch"
                     Text="{x:Bind ViewModel.TfaCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Two-factor code" />

            <Button x:Name="VerifyButton"
                    Style="{StaticResource BrandPrimaryButton}"
                    HorizontalAlignment="Stretch"
                    IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource NotNullToBool}, ConverterParameter=invert}"
                    Command="{x:Bind ViewModel.VerifyCommand}"
                    AutomationProperties.Name="Verify">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing Width="16" Height="16"
                                  IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="Verify" />
                </StackPanel>
            </Button>

            <InfoBar Severity="Error"
                     IsOpen="{x:Bind ViewModel.TfaError, Mode=OneWay, Converter={StaticResource NotNullToBool}}"
                     Message="{x:Bind ViewModel.TfaError, Mode=OneWay}"
                     IsClosable="False" />

            <HyperlinkButton x:Name="ResendButton"
                             Content="Resend code"
                             HorizontalAlignment="Center"
                             Click="OnResendClick" />
        </StackPanel>
    </Grid>
</Page>
