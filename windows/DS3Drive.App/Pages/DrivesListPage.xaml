<?xml version="1.0" encoding="utf-8"?>
<!--
    DrivesListPage — post-tutorial landing page. Per 17-UI-SPEC.md §"Component Inventory":
    Type.H2 header "DS3 Drives", a ListView of drives (temporary inline row; Plan 11
    promotes it to a reusable DriveRow control), the primary "Add drive" / "Add your first
    drive" CTA (hidden at the 3-drive cap per D-23), and the "No drives yet" empty state
    (UI-SPEC §Empty states). Add navigates to the DriveSetupWizardPage.
-->
<Page
    x:Class="DS3Drive.App.Pages.DrivesListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DS3Drive.ViewModels.ViewModels"
    xmlns:records="using:DS3Drive.Core.Records"
    xmlns:conv="using:DS3Drive.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid Padding="48" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource Type.H2}" Text="DS3 Drives" />

        <!-- Populated list. -->
        <ListView Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.Drives, Mode=OneWay}"
                  Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="records:DS3Drive">
                    <StackPanel Spacing="4" Padding="0,8">
                        <TextBlock Style="{StaticResource Type.Body}" Text="{x:Bind Name}" />
                        <TextBlock Style="{StaticResource Type.Caption}" Text="{x:Bind SyncAnchor.Bucket}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Empty state. -->
        <StackPanel Grid.Row="1" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource Type.H2}" HorizontalAlignment="Center" Text="No drives yet" />
            <TextBlock Style="{StaticResource Type.BodySecondary}" HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="420"
                       Text="Add a drive to start syncing files between this PC and Cubbit DS3." />
        </StackPanel>

        <!-- Primary CTA — hidden at the 3-drive cap (D-23). -->
        <Button Grid.Row="2"
                Style="{StaticResource BrandPrimaryButton}"
                HorizontalAlignment="Center"
                Content="{x:Bind ViewModel.AddDriveLabel, Mode=OneWay}"
                Command="{x:Bind ViewModel.AddDriveCommand}"
                Visibility="{x:Bind ViewModel.CanAddDrive, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                AutomationProperties.Name="Add drive" />
    </Grid>
</Page>
