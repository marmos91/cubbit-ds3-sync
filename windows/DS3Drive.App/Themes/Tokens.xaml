<?xml version="1.0" encoding="utf-8"?>
<!--
    Tokens.xaml — design-token ResourceDictionary for the DS3 Drive Windows shell.
    Port of the macOS design system (apple/DS3Drive/Views/Common/DesignSystem/
    DS3Colors.swift + DS3Typography.swift + DS3Spacing.swift), trimmed to the
    Windows constraints declared in 17-UI-SPEC.md:

      Revision 1 — Typography: 4 sizes only (12 / 14 / 24 / 32). No Type.H3 (18px).
      Revision 2 — Typography: 2 weights only (Regular 400 / SemiBold 600). No Medium.
      Revision 3 — Spacing: subset {4, 8, 16, 24, 32, 48}. No 12px.

    Layering (load order in App.xaml): Tokens -> Brushes -> Typography -> control styles.
    This dictionary holds only dependency-free tokens (Color / Thickness / Double /
    FontFamily). SolidColorBrush wrappers + dark/light ThemeDictionaries live in
    Brushes.xaml (merged after this). Typography Styles live in Typography.xaml
    (merged after Brushes) because they reference theme brushes via {ThemeResource};
    keeping the one-way layering avoids the merge-order cycle that crashed XAML load.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================== Color tokens (DS3Colors.swift) ===================== -->
    <!-- Composer canary palette — ported 1:1, ARGB hex (parity yardstick D-00). -->
    <Color x:Key="BrandPrimary">#FF005CE8</Color>
    <Color x:Key="BrandPrimaryLight">#FF337CEC</Color>
    <Color x:Key="BrandPrimaryDark">#FF0047B3</Color>
    <Color x:Key="BrandBg900">#FF0E0E15</Color>
    <Color x:Key="BrandBg800">#FF121212</Color>

    <!-- Status palette (semantic). -->
    <Color x:Key="StatusSuccess">#FF26AB75</Color>
    <Color x:Key="StatusSyncing">#FF005CE8</Color>
    <Color x:Key="StatusWarning">#FFFFB74D</Color>
    <Color x:Key="StatusErrorMain">#FFE56363</Color>
    <Color x:Key="StatusErrorDark">#FFDC2D20</Color>
    <Color x:Key="StatusInfo">#FF5498FF</Color>
    <!-- Conflict (StatusPill 5th variant, UI-SPEC §Visual States) — distinct amber/orange. -->
    <Color x:Key="StatusConflict">#FFE8833A</Color>
    <!-- 45% white — placeholder / cloud-only dimming. -->
    <Color x:Key="StatusCloudOnly">#73FFFFFF</Color>

    <!-- ===================== Spacing tokens (DS3Spacing.swift, Revision 3) ===================== -->
    <!-- Subset of {4, 8, 16, 24, 32, 48}; 12px deliberately omitted. -->
    <!-- Thickness variants (uniform) for Margin / Padding. -->
    <Thickness x:Key="SpaceXs">4</Thickness>
    <Thickness x:Key="SpaceSm">8</Thickness>
    <Thickness x:Key="SpaceMd">16</Thickness>
    <Thickness x:Key="SpaceLg">24</Thickness>
    <Thickness x:Key="SpaceXl">32</Thickness>
    <Thickness x:Key="Space2xl">48</Thickness>

    <!-- Double variants for Spacing / Width / Height / StackPanel.Spacing. -->
    <x:Double x:Key="SpaceXsValue">4</x:Double>
    <x:Double x:Key="SpaceSmValue">8</x:Double>
    <x:Double x:Key="SpaceMdValue">16</x:Double>
    <x:Double x:Key="SpaceLgValue">24</x:Double>
    <x:Double x:Key="SpaceXlValue">32</x:Double>
    <x:Double x:Key="Space2xlValue">48</x:Double>

    <!-- ===================== Font family ===================== -->
    <!-- Figtree Regular + SemiBold bundled in Assets/Fonts; Segoe UI Variable fallback. -->
    <FontFamily x:Key="FontFamily.Body">ms-appx:///Assets/Fonts/Figtree-Regular.ttf#Figtree, Segoe UI Variable, Segoe UI</FontFamily>

</ResourceDictionary>
