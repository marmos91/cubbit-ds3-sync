<?xml version="1.0" encoding="utf-8"?>
<!--
    Brushes.xaml — SolidColorBrush tokens for the DS3 Drive Windows shell.
    Theme-aware: Dark (primary, matches the macOS shipped default) + Light
    (OS-light-mode adaptation) per 17-UI-SPEC.md §Color (Dark + Light tables).

    Brand-accent + status brushes are theme-INVARIANT (accent #005CE8 is the same
    in both themes per UI-SPEC §Color). Surface + text + border brushes flip
    between the Default (Dark) and Light dictionaries.

    Color tokens consumed here come from Tokens.xaml. Both dictionaries are merged
    into App.Resources so cross-dictionary StaticResource lookups resolve.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Theme-invariant brand + status brushes (same value in dark & light) ===== -->
    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{StaticResource BrandPrimary}" />
    <SolidColorBrush x:Key="BrandPrimaryLightBrush" Color="{StaticResource BrandPrimaryLight}" />
    <SolidColorBrush x:Key="BrandPrimaryDarkBrush" Color="{StaticResource BrandPrimaryDark}" />

    <SolidColorBrush x:Key="StatusSuccessBrush" Color="{StaticResource StatusSuccess}" />
    <SolidColorBrush x:Key="StatusSyncingBrush" Color="{StaticResource StatusSyncing}" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="{StaticResource StatusWarning}" />
    <SolidColorBrush x:Key="StatusErrorMainBrush" Color="{StaticResource StatusErrorMain}" />
    <SolidColorBrush x:Key="StatusErrorDarkBrush" Color="{StaticResource StatusErrorDark}" />
    <SolidColorBrush x:Key="StatusInfoBrush" Color="{StaticResource StatusInfo}" />
    <SolidColorBrush x:Key="StatusCloudOnlyBrush" Color="{StaticResource StatusCloudOnly}" />

    <!-- ===== Theme-flipped surface / text / border brushes ===== -->
    <ResourceDictionary.ThemeDictionaries>

        <!-- Dark theme (primary). -->
        <ResourceDictionary x:Key="Default">
            <!-- Surfaces. -->
            <SolidColorBrush x:Key="BrandBg900Brush" Color="{StaticResource BrandBg900}" />
            <SolidColorBrush x:Key="BrandBg800Brush" Color="{StaticResource BrandBg800}" />
            <!-- Text. -->
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#99FFFFFF" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#73FFFFFF" />
            <SolidColorBrush x:Key="TextDisabledBrush" Color="#4DFFFFFF" />
            <!-- Borders / dividers. -->
            <SolidColorBrush x:Key="BorderUltraSubtleBrush" Color="#0AFFFFFF" />
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="BorderStrongBrush" Color="#4DFFFFFF" />
            <SolidColorBrush x:Key="DividerBrush" Color="#1FFFFFFF" />
        </ResourceDictionary>

        <!-- Light theme (OS-light-mode adaptation). -->
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="BrandBg900Brush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="BrandBg800Brush" Color="#FFF5F5F7" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF121212" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#99000000" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#73000000" />
            <SolidColorBrush x:Key="TextDisabledBrush" Color="#4D000000" />
            <SolidColorBrush x:Key="BorderUltraSubtleBrush" Color="#0A000000" />
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="#1A000000" />
            <SolidColorBrush x:Key="BorderStrongBrush" Color="#4D000000" />
            <SolidColorBrush x:Key="DividerBrush" Color="#1F000000" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
