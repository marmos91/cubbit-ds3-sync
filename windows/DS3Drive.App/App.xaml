<?xml version="1.0" encoding="utf-8"?>
<!--
    App.xaml — application resources for the DS3 Drive Windows shell (Plan 08).
    Merges the brand design system (Tokens.xaml colors/spacing/typography +
    Brushes.xaml theme-aware brushes) and the reusable brand button styles on top
    of the Fluent v2 XamlControlsResources base, per 17-UI-SPEC.md §Design System.
-->
<Application
    x:Class="DS3Drive.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Themes/Brushes.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/Tokens.xaml" />
                <ResourceDictionary Source="ms-appx:///Controls/BrandPrimaryButton.xaml" />
                <ResourceDictionary Source="ms-appx:///Controls/BrandSecondaryButton.xaml" />
                <ResourceDictionary Source="ms-appx:///Controls/BrandDestructiveButton.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
