<Project>

  <!--
    Shared MSBuild properties for the DS3 Drive Windows solution.
    Applied automatically to every project under windows/ (App, Sync, Core, Tests).
    See .planning/phases/17-windows-shell/17-CONTEXT.md D-01, D-02, D-04.
  -->
  <PropertyGroup>
    <!-- C# 12 default for net8.0; bump only if a specific feature warrants (CONTEXT Claude's Discretion). -->
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Quality gates: warnings are errors, code style enforced at build. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Reproducible restores: lock file pins transitive package versions. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!-- Deterministic builds for reproducible installer artifacts. -->
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- C# linter applied to every C# project. Analyzers only (PrivateAssets=all): they run
       at build/IDE time but are never published as a dependency. Version pinned centrally in
       Directory.Packages.props. Scoped to .csproj so the WiX installer (.wixproj), which also
       imports this file, does not pull in a C# analyzer it cannot use. -->
  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <PackageReference Include="Roslynator.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
